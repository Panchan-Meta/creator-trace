{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creator-trace-api",
  "keep_vars": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creator-trace-db",
      "database_id": "c8437401-e69a-4423-9818-29fed9347dd3",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROOFS",
      "bucket_name": "creator-trace-proofs"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp/*",
      "/admin/*"
    ]
  },
  "vars": {
    "SIGNUP_ENABLED": "true",
    "XAI_BASE_URL": "https://api.x.ai/v1",
    "XAI_MODEL": "grok-4.20-0309-non-reasoning",
    "APP_ORIGIN": "https://creator-trace-api.punkaproof.workers.dev",
    "RP_ID": "creator-trace-api.punkaproof.workers.dev",
    "BITCOIN_API_BASE_URL": "https://blockstream.info/api"
  }
}
